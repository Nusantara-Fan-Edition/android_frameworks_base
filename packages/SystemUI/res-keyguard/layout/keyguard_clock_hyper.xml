<?xml version="1.0" encoding="utf-8"?>
<com.android.keyguard.clock.ClockLayout
    android:gravity="start|center"
    android:layout_gravity="start|center"
    android:orientation="vertical"
    android:paddingBottom="100dp"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10.0dip"
        android:layout_marginStart="13dp">
        <TextClock
            android:textSize="180.0dp"
            android:textColor="?wallpaperTextColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:id="@+id/hyper_clock_hour"
            android:fontFamily="@font/filled"
            android:format12Hour="hh"/>
        <TextClock
            android:textSize="180.0dp"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:id="@+id/hyper_clock_min"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fontFamily="@font/hollow"
            android:format12Hour="mm"/>
    </LinearLayout>
    <TextClock
        android:textSize="20.0dp"
        android:textColor="@android:color/white"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:id="@+id/hyper_date"
        android:layout_marginStart="26dp"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:layout_marginTop="-5dp"
        android:layout_marginBottom="5dp"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE"/>
</com.android.keyguard.clock.ClockLayout>
